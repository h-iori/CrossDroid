<Page
    x:Class="CrossDroid.Windows.Views.TransfersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource BgMain}">

    <Page.Transitions>
        <TransitionCollection>
            <EntranceThemeTransition FromHorizontalOffset="0" FromVerticalOffset="28"/>
        </TransitionCollection>
    </Page.Transitions>

    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="Transfers" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextStrong}" />
                <TextBlock Text="Active and staged transfers" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="6">
                <Button Click="SimulateIncoming_Click" Height="32" Padding="8,2" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" ToolTipService.ToolTip="Simulate Incoming Request">
                    <FontIcon Glyph="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource TextBody}"/>
                </Button>
                <Button Click="PauseAll_Click" Height="32" Padding="8,2" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" ToolTipService.ToolTip="Pause / Resume All">
                    <FontIcon Glyph="&#xE103;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource TextBody}"/>
                </Button>
                <Button Click="CancelAll_Click" Height="32" Padding="8,2" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource ColorError}" ToolTipService.ToolTip="Cancel All">
                    <FontIcon Glyph="&#xE10A;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource ColorError}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Pivot Navigation for Portrait -->
        <Pivot x:Name="TransfersPivot" Grid.Row="1" Background="Transparent">
            
            <!-- Tab 1: Active Transfers -->
            <PivotItem Header="Active" Margin="0,12,0,0">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Overall Progress -->
                        <RowDefinition Height="*" />    <!-- Active List -->
                    </Grid.RowDefinitions>

                    <!-- Overall Progress Card -->
                    <Border Grid.Row="0" CornerRadius="12" Background="{StaticResource BgElevated}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Padding="12">
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="Overall Progress" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}"/>
                                <TextBlock x:Name="OverallProgressText" Text="Staging (0%)" FontSize="13" Foreground="{StaticResource AccentCyan}" HorizontalAlignment="Right"/>
                            </Grid>
                            
                            <ProgressBar x:Name="OverallProgressBar" Value="0" Maximum="100" Height="6" CornerRadius="3" Background="{StaticResource BgSurface}" Foreground="{StaticResource NeonPrimary}"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock x:Name="SpeedText" Text="Speed: 0.0 MB/s" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock x:Name="TimeRemainingText" Text="Remaining: --:--" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                                <Border Grid.Column="1" VerticalAlignment="Center" Padding="8,4" CornerRadius="6" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentCyan}"/>
                                        <TextBlock Text="Idle" x:Name="QueueStatusText" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBody}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="TransferredItemsText" Text="Items: 0 / 0" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>

                    <!-- Active Transfers ListView -->
                    <Grid Grid.Row="1" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Queue Items" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}"/>
                        
                        <ListView x:Name="QueueItemsList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="False" ItemsSource="{x:Bind QueueItems, Mode=OneWay}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,10" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Background="{StaticResource BgElevated}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Padding="12">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Icon -->
                                            <FontIcon Grid.Column="0" Glyph="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentCyan}" FontSize="20" VerticalAlignment="Center"/>

                                            <!-- File Info & Progress -->
                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" TextTrimming="CharacterEllipsis"/>
                                                <ProgressBar Value="{Binding ProgressValue}" Maximum="100" Height="4" CornerRadius="2" Background="{StaticResource BgSurface}" Foreground="{StaticResource NeonPrimary}"/>
                                                <Grid>
                                                    <TextBlock Text="{Binding FileSize}" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                                    <TextBlock Text="{Binding ProgressPercentText}" FontSize="11" Foreground="{StaticResource AccentCyan}" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </StackPanel>

                                            <!-- Controls -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Button Click="ItemPause_Click" Background="Transparent" BorderThickness="0" Padding="4">
                                                    <FontIcon Glyph="{Binding PauseGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource TextSecondary}"/>
                                                </Button>
                                                <Button Click="ItemCancel_Click" Background="Transparent" BorderThickness="0" Padding="4">
                                                    <FontIcon Glyph="&#xE10A;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource ColorError}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </PivotItem>

            <!-- Tab 2: Staged Files -->
            <PivotItem Header="Send Staged" Margin="0,12,0,0">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Staged List -->
                    <Border Grid.Row="0" CornerRadius="12" Background="{StaticResource BgElevated}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Padding="12">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Staged for Sending" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}"/>
                                <TextBlock Text="Files shared from explorer or dashboard" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <ListView x:Name="StagedItemsList" Grid.Row="1" SelectionMode="None" Padding="0,4,0,0" ItemsSource="{x:Bind StagedItems, Mode=OneWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,6" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12.5" Foreground="{StaticResource TextBody}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Click="RemoveStaged_Click" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Padding="4">
                                                <FontIcon Glyph="&#xE10A;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Destination and Start Actions -->
                    <Border Grid.Row="1" CornerRadius="12" Background="{StaticResource BgElevated}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Padding="12">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Select Destination Device" FontSize="11.5" Foreground="{StaticResource TextSecondary}"/>
                            <ComboBox x:Name="TargetDeviceCombo" HorizontalAlignment="Stretch" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" Foreground="{StaticResource TextStrong}" PlaceholderText="Select Device..." SelectedIndex="0"/>
                            <Button Content="Start Transfer" Click="StartTransfer_Click" HorizontalAlignment="Stretch" Background="{StaticResource AccentCyan}" Foreground="{StaticResource BgMain}" FontWeight="Bold" BorderThickness="0" Height="36"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </PivotItem>
        </Pivot>

        <!-- Simulated Incoming Request Modal Dialog Overlay -->
        <Grid x:Name="IncomingOverlay" Grid.RowSpan="2" Background="{StaticResource TranslucentBg}" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border CornerRadius="16" Background="{StaticResource BgElevated}" BorderBrush="{StaticResource NeonPrimaryBorderBrush}" BorderThickness="1.5" Width="320" Height="260" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20" Shadow="{StaticResource ThemeShadow}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE104;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource NeonPrimary}" FontSize="18"/>
                        <TextBlock Text="Incoming Request" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextStrong}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Spacing="6" Margin="0,4,0,0">
                        <TextBlock x:Name="IncomingDeviceText" Text="Device 'Pixel 8 Pro' wants to send files." FontSize="13.5" Foreground="{StaticResource TextBody}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="IncomingDetailsText" Text="Total Size: 48.5 MB" FontSize="11.5" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="Accept the incoming transfer?" FontSize="12.5" Foreground="{StaticResource TextBody}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="2" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Reject" Click="RejectIncoming_Click" HorizontalAlignment="Stretch" Height="36" Background="{StaticResource BgSurface}" Foreground="{StaticResource ColorError}" BorderBrush="{StaticResource BorderSubtle}"/>
                        <Button Grid.Column="1" Content="Accept" Click="AcceptIncoming_Click" HorizontalAlignment="Stretch" Height="36" Background="{StaticResource NeonPrimary}" Foreground="{StaticResource TextStrong}" BorderThickness="0"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
