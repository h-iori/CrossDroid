<Page
    x:Class="CrossDroid.Windows.Views.TransferStreamView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:CrossDroid.Windows.Views"
    xmlns:common="using:CrossDroid.Windows"
    mc:Ignorable="d"
    Background="{StaticResource BgMain}">

    <Page.Transitions>
        <TransitionCollection>
            <EntranceThemeTransition FromHorizontalOffset="0" FromVerticalOffset="28"/>
        </TransitionCollection>
    </Page.Transitions>

    <Page.Resources>
        <!-- Outgoing Bubble Template -->
        <DataTemplate x:Key="OutgoingBubbleTemplate" x:DataType="local:TransferBubbleViewModel">
            <Grid HorizontalAlignment="Right" Margin="32,0,0,10" MinWidth="220" MaxWidth="360">
                <Border CornerRadius="12,12,4,12" Background="{StaticResource SendCardBg}" BorderBrush="#55D455FF" BorderThickness="1" Padding="8,8,8,6">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header: Icon, Name, Size, Controls -->
                        <Grid Grid.Row="0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6" Background="#1ED455FF" BorderBrush="#40D455FF" BorderThickness="1">
                                <FontIcon Glyph="{x:Bind IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource NeonHighlight}"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                                <TextBlock Text="{x:Bind FileName}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind FileSize}" FontSize="9" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Visibility="{x:Bind ActiveUIVisibility}">
                                <Button Width="24" Height="24" Padding="0" CornerRadius="12" Background="#1CD455FF" BorderBrush="#3DD455FF" BorderThickness="1" common:MouseCursorHelper.HandCursor="True">
                                    <FontIcon Glyph="&#xE769;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource NeonHighlight}"/>
                                </Button>
                                <Button Width="24" Height="24" Padding="0" CornerRadius="12" Background="#1CFF3366" BorderBrush="#3DFF3366" BorderThickness="1" common:MouseCursorHelper.HandCursor="True">
                                    <FontIcon Glyph="&#xE10A;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource ColorError}"/>
                                </Button>
                            </StackPanel>

                            <Border Grid.Column="2" Visibility="{x:Bind InactiveUIVisibility}" Width="20" Height="20" CornerRadius="10" Background="#1C00FF88" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE10B;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="{StaticResource ColorSuccess}"/>
                            </Border>
                        </Grid>

                        <!-- Progress Bar (Visible if Active) -->
                        <Border Grid.Row="1" Height="4" CornerRadius="2" Background="{StaticResource BgSurface}" Visibility="{x:Bind ActiveUIVisibility}">
                            <ProgressBar Value="{x:Bind ProgressValue, Mode=OneWay}" Maximum="100" Height="4" Foreground="{StaticResource NeonPrimary}" Background="Transparent" />
                        </Border>

                        <!-- Footer: Status & Speed -->
                        <Grid Grid.Row="2">
                            <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource NeonHighlight}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{x:Bind SpeedText, Mode=OneWay}" FontSize="9" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" Visibility="{x:Bind ActiveUIVisibility}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Incoming Bubble Template -->
        <DataTemplate x:Key="IncomingBubbleTemplate" x:DataType="local:TransferBubbleViewModel">
            <Grid HorizontalAlignment="Left" Margin="0,0,32,10" MinWidth="220" MaxWidth="360">
                <Border CornerRadius="12,12,12,4" Background="{StaticResource ReceiveCardBg}" BorderBrush="#E6262B38" BorderThickness="1" Padding="8,8,8,6">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6" Background="#1E27D7E7" BorderBrush="#4027D7E7" BorderThickness="1">
                                <FontIcon Glyph="{x:Bind IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource AccentCyan}"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                                <TextBlock Text="{x:Bind FileName}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind FileSize}" FontSize="9" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Visibility="{x:Bind ActiveUIVisibility}">
                                <Button Width="24" Height="24" Padding="0" CornerRadius="12" Background="#1C27D7E7" BorderBrush="#3D27D7E7" BorderThickness="1" common:MouseCursorHelper.HandCursor="True">
                                    <FontIcon Glyph="&#xE769;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource AccentCyan}"/>
                                </Button>
                                <Button Width="24" Height="24" Padding="0" CornerRadius="12" Background="#1CFF3366" BorderBrush="#3DFF3366" BorderThickness="1" common:MouseCursorHelper.HandCursor="True">
                                    <FontIcon Glyph="&#xE10A;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource ColorError}"/>
                                </Button>
                            </StackPanel>

                            <Border Grid.Column="2" Visibility="{x:Bind InactiveUIVisibility}" Width="20" Height="20" CornerRadius="10" Background="#1C00FF88" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE10B;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="{StaticResource ColorSuccess}"/>
                            </Border>
                        </Grid>

                        <!-- Progress Bar -->
                        <Border Grid.Row="1" Height="4" CornerRadius="2" Background="{StaticResource BgSurface}" Visibility="{x:Bind ActiveUIVisibility}">
                            <ProgressBar Value="{x:Bind ProgressValue, Mode=OneWay}" Maximum="100" Height="4" Foreground="{StaticResource AccentCyan}" Background="Transparent" />
                        </Border>

                        <!-- Footer -->
                        <Grid Grid.Row="2">
                            <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource AccentCyan}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{x:Bind SpeedText, Mode=OneWay}" FontSize="9" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" Visibility="{x:Bind ActiveUIVisibility}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <local:TransferBubbleTemplateSelector x:Key="BubbleSelector" 
            OutgoingTemplate="{StaticResource OutgoingBubbleTemplate}" 
            IncomingTemplate="{StaticResource IncomingBubbleTemplate}" />
    </Page.Resources>

    <Grid Padding="12,6,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top App Bar & Peer Info -->
        <Grid Grid.Row="0" Margin="0,0,0,8" Padding="0,0,0,8" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Background="Transparent" BorderThickness="0" Click="BackButton_Click" Padding="6" common:MouseCursorHelper.HandCursor="True">
                    <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource TextStrong}"/>
                </Button>
                <Border Width="28" Height="28" CornerRadius="14" Background="#26BF00FF" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8CA;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource NeonHighlight}"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="0">
                    <TextBlock x:Name="PeerDeviceNameText" Text="Windows-PC" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextStrong}"/>
                    <TextBlock x:Name="PeerStatusText" Text="Transferring 0 of 0 files" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border VerticalAlignment="Center" CornerRadius="6" Background="#1CBF00FF" BorderBrush="#42D455FF" BorderThickness="1" Padding="8,4">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="TOTAL SPEED" FontSize="8" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TotalSpeedText" Text="0.0 MB/s" FontSize="12" FontWeight="Bold" Foreground="{StaticResource NeonHighlight}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Active Chat Progression List -->
        <ListView x:Name="ChatList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="False" ItemsSource="{x:Bind ChatBubbles, Mode=OneWay}" ItemTemplateSelector="{StaticResource BubbleSelector}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <!-- Bottom Elegant Send Bar -->
        <Border Grid.Row="2" CornerRadius="12,12,4,4" Background="{StaticResource BgElevated}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="8" Margin="-12,0,-12,-12">
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="20" Padding="10,6" common:MouseCursorHelper.HandCursor="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <FontIcon Grid.Column="0" Glyph="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource NeonPrimary}" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="Send files to this device..." FontSize="11.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    
                    <!-- Simulating the right Action Icon -->
                    <Border Grid.Column="2" Width="26" Height="26" CornerRadius="13" Background="{StaticResource NeonPrimary}">
                        <FontIcon Glyph="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource TextStrong}"/>
                    </Border>
                </Grid>
            </Button>
        </Border>
    </Grid>
</Page>
