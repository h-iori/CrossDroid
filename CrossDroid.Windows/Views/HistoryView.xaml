<Page
    x:Class="CrossDroid.Windows.Views.HistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:CrossDroid.Windows.Views"
    mc:Ignorable="d"
    Background="{StaticResource BgMain}">

    <Page.Transitions>
        <TransitionCollection>
            <EntranceThemeTransition FromHorizontalOffset="0" FromVerticalOffset="28"/>
        </TransitionCollection>
    </Page.Transitions>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20" Spacing="4">
            <TextBlock Text="Transfer History" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextStrong}" />
            <TextBlock Text="Log of successfully received and sent files" FontSize="12" Foreground="{StaticResource TextSecondary}" />
        </StackPanel>

        <!-- History ListView (Enterprise Cyberpunk styling) -->
        <ListView x:Name="HistoryItemsList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="False" ItemsSource="{x:Bind DisplayedItems, Mode=OneWay}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,10" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:HistoryItemViewModel">
                    <Border CornerRadius="16" Background="{StaticResource BgElevated}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1.2" Padding="14">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Success / Fail Indicator Icon -->
                            <Border Grid.Column="0" CornerRadius="16" Background="{x:Bind IconBg}" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
                                <FontIcon Glyph="{x:Bind StatusGlyph}" FontFamily="Segoe MDL2 Assets" Foreground="{x:Bind StatusBrush}" FontSize="13"/>
                            </Border>

                            <!-- Details -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind FileName}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind FileSize}" FontSize="11" Foreground="{StaticResource AccentCyan}" FontWeight="SemiBold"/>
                                    <TextBlock Text="•" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock Text="{x:Bind DateText}" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                                <TextBlock Text="{x:Bind DetailMessage}" FontSize="11" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Quick Action Buttons -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Click="OpenFile_Click" Background="Transparent" BorderThickness="0" Padding="8,6" Visibility="{x:Bind OpenVisible}" ToolTipService.ToolTip="Open File" CornerRadius="8">
                                    <FontIcon Glyph="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource AccentCyan}"/>
                                </Button>
                                <Button Click="OpenFolder_Click" Background="Transparent" BorderThickness="0" Padding="8,6" Visibility="{x:Bind OpenVisible}" ToolTipService.ToolTip="Open Folder" CornerRadius="8">
                                    <FontIcon Glyph="&#xE8DA;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource TextSecondary}"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
