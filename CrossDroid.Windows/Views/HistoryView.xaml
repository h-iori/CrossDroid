<Page
    x:Class="CrossDroid.Windows.Views.HistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:CrossDroid.Windows.Views"
    xmlns:common="using:CrossDroid.Windows"
    mc:Ignorable="d"
    Background="{StaticResource BgMain}">

    <Page.Transitions>
        <TransitionCollection>
            <EntranceThemeTransition FromHorizontalOffset="0" FromVerticalOffset="28"/>
        </TransitionCollection>
    </Page.Transitions>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="4">
            <TextBlock Text="Transfer History" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextStrong}" />
            <TextBlock Text="Log of device-grouped transfers and activity" FontSize="11" Foreground="{StaticResource TextSecondary}" />
        </StackPanel>

        <!-- History ListView (Enterprise Cyberpunk styling) -->
        <ListView x:Name="HistoryItemsList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="False" ItemsSource="{x:Bind DisplayedItems, Mode=OneWay}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="12" />
                    <Setter Property="Margin" Value="0,0,0,10" />
                    <Setter Property="CornerRadius" Value="12" />
                    <Setter Property="Background" Value="{StaticResource BgElevated}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
                    <Setter Property="BorderThickness" Value="1.2" />
                    <Setter Property="common:MouseCursorHelper.HandCursor" Value="True" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:HistoryItemViewModel">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Device Icon -->
                        <Border Grid.Column="0" CornerRadius="18" Background="{StaticResource BgSurface}" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
                            <FontIcon Glyph="{x:Bind DeviceIconGlyph}" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource NeonPrimary}" FontSize="15"/>
                        </Border>

                        <!-- Details (Professional & Detailed) -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind DeviceName}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextStrong}" TextTrimming="CharacterEllipsis"/>
                                <Border Padding="5,1.5" CornerRadius="4" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind DeviceType}" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind TransfersCountText}" FontSize="10" Foreground="{StaticResource AccentCyan}" FontWeight="SemiBold"/>
                                <TextBlock Text="•" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="{x:Bind TotalBytesText}" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="•" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="{x:Bind DateText}" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                            <TextBlock Text="{x:Bind LastTransferInfo}" FontSize="10.5" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Status Badge (Success / Fail Indicator Icon) -->
                        <Border Grid.Column="2" CornerRadius="12" Background="{x:Bind IconBg}" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="{x:Bind StatusGlyph}" FontFamily="Segoe MDL2 Assets" Foreground="{x:Bind StatusBrush}" FontSize="9"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
