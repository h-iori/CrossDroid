<Page
    x:Class="CrossDroid.Windows.Views.RadarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:common="using:CrossDroid.Windows"
    mc:Ignorable="d"
    Background="{StaticResource BgMain}">

    <Page.Transitions>
        <TransitionCollection>
            <EntranceThemeTransition FromHorizontalOffset="0" FromVerticalOffset="28"/>
        </TransitionCollection>
    </Page.Transitions>

    <Grid Padding="24" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top App Bar Area -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <Button Background="Transparent" BorderThickness="0" Click="BackButton_Click" Padding="8" common:MouseCursorHelper.HandCursor="True">
                    <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource TextStrong}"/>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Radar Discovery" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextStrong}"/>
                    <TextBlock Text="Nearby peer terminals" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Radar Display Area -->
        <Border Grid.Row="1" CornerRadius="24" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource AccentCyanBorderBrush}" BorderThickness="1" Padding="16" Margin="16,0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="360" Height="360">
            <Grid x:Name="RadarCanvas">
                <Grid.Resources>
                    <Storyboard x:Name="RadarSweepAnimation" RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetName="RadarSweepTransform" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:3"/>
                    </Storyboard>
                </Grid.Resources>

                <!-- Radar Circles -->
                <Ellipse Width="300" Height="300" Stroke="{StaticResource AccentCyan}" StrokeThickness="1" Opacity="0.1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Width="200" Height="200" Stroke="{StaticResource AccentCyan}" StrokeThickness="1" Opacity="0.2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Width="100" Height="100" Stroke="{StaticResource AccentCyan}" StrokeThickness="1" Opacity="0.3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                
                <!-- Crosshairs -->
                <Line X1="160" Y1="0" X2="160" Y2="320" Stroke="{StaticResource AccentCyan}" StrokeThickness="1" Opacity="0.2"/>
                <Line X1="0" Y1="160" X2="320" Y2="160" Stroke="{StaticResource AccentCyan}" StrokeThickness="1" Opacity="0.2"/>

                <!-- Sweeping Radar Line (Mocked via RenderTransform animation) -->
                <Grid Width="300" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RenderTransform>
                        <RotateTransform x:Name="RadarSweepTransform" CenterX="150" CenterY="150" Angle="0"/>
                    </Grid.RenderTransform>
                    <!-- A cone-like shape for the radar sweep could be drawn here, we'll use a simple wedge/line for now -->
                    <Path Data="M 150,150 L 150,0 A 150,150 0 0 1 256,44 Z" Fill="{StaticResource AccentCyan}" Opacity="0.15" />
                    <Line X1="150" Y1="150" X2="150" Y2="0" Stroke="{StaticResource AccentCyan}" StrokeThickness="2" Opacity="0.8"/>
                </Grid>

                <!-- Mock Devices -->
                <!-- Device 1: Android Phone -->
                <Button Click="Device_Click" Tag="Pixel 8 Pro" Margin="-120,-80,0,0" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" common:MouseCursorHelper.HandCursor="True">
                    <StackPanel Spacing="4">
                        <Border Width="44" Height="44" CornerRadius="14" Background="#1A1ED455" BorderBrush="#4D1ED455" BorderThickness="1">
                            <FontIcon Glyph="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource ColorSuccess}"/>
                        </Border>
                        <TextBlock Text="Pixel 8 Pro" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextStrong}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Device 2: Windows PC -->
                <Button Click="Device_Click" Tag="Desktop-PC" Margin="140,60,0,0" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" common:MouseCursorHelper.HandCursor="True">
                    <StackPanel Spacing="4">
                        <Border Width="44" Height="44" CornerRadius="14" Background="#1A27D7E7" BorderBrush="#4D27D7E7" BorderThickness="1">
                            <FontIcon Glyph="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource AccentCyan}"/>
                        </Border>
                        <TextBlock Text="Desktop-PC" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextStrong}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Device 3: Another Phone -->
                <Button Click="Device_Click" Tag="Galaxy S23" Margin="-40,160,0,0" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" common:MouseCursorHelper.HandCursor="True">
                    <StackPanel Spacing="4">
                        <Border Width="44" Height="44" CornerRadius="14" Background="#1A1ED455" BorderBrush="#4D1ED455" BorderThickness="1">
                            <FontIcon Glyph="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource ColorSuccess}"/>
                        </Border>
                        <TextBlock Text="Galaxy S23" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextStrong}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Bottom PIN Input Section -->
        <Border Grid.Row="2" CornerRadius="16" Background="{StaticResource BgElevated}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1.2" Padding="20">
            <StackPanel Spacing="12">
                <TextBlock Text="Connect via PIN" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextStrong}"/>
                <TextBlock Text="Enter the 4-digit PIN of a hidden or distant terminal to connect manually." FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <TextBox x:Name="PinTextBox" Grid.Column="0" PlaceholderText="0000" MaxLength="4" FontSize="18" FontWeight="Bold" CharacterSpacing="200" HorizontalAlignment="Stretch" VerticalAlignment="Center" TextAlignment="Center" Background="{StaticResource BgSurface}"/>
                    
                    <Button Grid.Column="1" Click="ConnectPin_Click" Height="40" Padding="16,0" CornerRadius="8" Background="{StaticResource NeonPrimary}" BorderThickness="0" common:MouseCursorHelper.HandCursor="True">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource NeonPrimaryColor}" Opacity="0.8" />
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource TextStrong}"/>
                            <TextBlock Text="Connect" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextStrong}"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Page>
