<Page
    x:Class="CrossDroid.Windows.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:common="using:CrossDroid.Windows"
    mc:Ignorable="d"
    Background="{StaticResource BgMain}">



    <Page.Transitions>
        <TransitionCollection>
            <EntranceThemeTransition FromHorizontalOffset="0" FromVerticalOffset="28"/>
        </TransitionCollection>
    </Page.Transitions>

    <Grid Padding="24" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Section: Visibility Toggle Switch Card -->
        <Border Grid.Row="0" CornerRadius="16" Background="{StaticResource BgElevated}" BorderBrush="{StaticResource NeonPrimaryBorderBrush}" BorderThickness="1.2" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Discovery Mode" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextStrong}"/>
                    <TextBlock x:Name="VisibilityStatusText" Text="Visible to nearby devices" FontSize="11" Foreground="{StaticResource ColorSuccess}"/>
                </StackPanel>
                <ToggleSwitch x:Name="VisibilityToggle" Grid.Column="1" IsOn="True" 
                               OnContent="ON" OffContent="OFF" 
                               Header="" MinWidth="0" VerticalAlignment="Center" 
                               Toggled="VisibilityToggle_Toggled" Foreground="{StaticResource TextBody}"
                               common:MouseCursorHelper.HandCursor="True" FontSize="12.5"/>
            </Grid>
        </Border>

        <!-- Main Display Panel Area -->
        <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch">
            
            <!-- PANEL A: ACTIVE DISCOVERY (Visible when Toggled On) -->
            <StackPanel x:Name="DiscoveryPanel" Spacing="24" Visibility="Visible" HorizontalAlignment="Center">
                
                <!-- QR Code Display Box with Neon Cyan borders and moving laser scanline -->
                <Border CornerRadius="16" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource AccentCyanBorderBrush}" BorderThickness="1.5" Padding="16" Height="170" Width="170" HorizontalAlignment="Center">
                    <Grid>
                        <!-- Cyberpunk cyan-glowing vector QR Code representation -->
                        <Image x:Name="QrCodeImage" Stretch="Uniform" />
                    </Grid>
                </Border>

                <!-- Secure verification PIN -->
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="SECURE PAIRING PIN" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" CharacterSpacing="80"/>
                    <Border Background="{StaticResource BgElevated}" CornerRadius="12" Padding="16,10" BorderThickness="1.2" BorderBrush="{StaticResource BorderSubtle}" HorizontalAlignment="Center" Width="160">
                        <TextBlock x:Name="PinTextBlock" Text="8429" FontSize="22" FontWeight="Bold" Foreground="{StaticResource NeonPrimary}" HorizontalAlignment="Center" CharacterSpacing="80" />
                    </Border>
                </StackPanel>

                <!-- Regenerate Refresh Button -->
                <Button Click="RefreshButton_Click" HorizontalAlignment="Center" Height="40" CornerRadius="12" Background="{StaticResource BgElevated}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Padding="16,0" common:MouseCursorHelper.HandCursor="True">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1D27D7E7" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{StaticResource AccentCyanColor}" />
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource TextBody}"/>
                        <TextBlock Text="Regenerate PIN" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBody}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- PANEL B: INACTIVE DISCOVERY (Visible when Toggled Off) -->
            <StackPanel x:Name="HiddenPanel" Spacing="20" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                
                <!-- Muted privacy/signal-off icon in cyber neon error colors -->
                <Border Width="90" Height="90" CornerRadius="45" Background="#1D12121A" BorderBrush="{StaticResource ColorError}" BorderThickness="1.5" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE814;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="{StaticResource ColorError}"/>
                </Border>

                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="DISCOVERY DISABLED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource ColorError}" HorizontalAlignment="Center" CharacterSpacing="100"/>
                    <TextBlock Text="You are not visible to nearby devices" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Temporary Send Button -->
        <Button Grid.Row="2" Click="TempSendButton_Click" HorizontalAlignment="Stretch" Height="48" CornerRadius="12" Background="{StaticResource AccentCyan}" BorderThickness="0" common:MouseCursorHelper.HandCursor="True">
            <Button.Resources>
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource AccentCyanColor}" Opacity="0.8" />
            </Button.Resources>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource TextStrong}"/>
                <TextBlock Text="Temporary Send Button" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextStrong}"/>
            </StackPanel>
        </Button>
    </Grid>
</Page>
