<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Windows.UI">

    <ui:Color x:Key="BgMainColor">#0A0A0F</ui:Color>
    <ui:Color x:Key="BgElevatedColor">#12121A</ui:Color>
    <ui:Color x:Key="BgSurfaceColor">#161622</ui:Color>
    <ui:Color x:Key="BgPanelColor">#10131B</ui:Color>
    <ui:Color x:Key="BgPanelMutedColor">#171B25</ui:Color>
    <ui:Color x:Key="BorderSubtleColor">#262B38</ui:Color>
    
    <ui:Color x:Key="NeonPrimaryColor">#BF00FF</ui:Color>
    <ui:Color x:Key="NeonGlowColor">#9B30FF</ui:Color>
    <ui:Color x:Key="NeonHighlightColor">#D455FF</ui:Color>
    <ui:Color x:Key="AccentBlueColor">#4F8CFF</ui:Color>
    <ui:Color x:Key="AccentCyanColor">#27D7E7</ui:Color>
    <ui:Color x:Key="AccentGreenColor">#34D399</ui:Color>
    <ui:Color x:Key="AccentAmberColor">#F8B84E</ui:Color>

    <ui:Color x:Key="TextStrongColor">#FFFFFF</ui:Color>
    <ui:Color x:Key="TextBodyColor">#EEEEFF</ui:Color>
    <ui:Color x:Key="TextSecondaryColor">#7A7A8E</ui:Color>
    <ui:Color x:Key="TextMutedColor">#4A4A5E</ui:Color>
    <ui:Color x:Key="ColorErrorColor">#FF3366</ui:Color>
    <ui:Color x:Key="ColorSuccessColor">#00FF88</ui:Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="BgMain" Color="{StaticResource BgMainColor}" />
    <SolidColorBrush x:Key="BgElevated" Color="{StaticResource BgElevatedColor}" />
    <SolidColorBrush x:Key="BgSurface" Color="{StaticResource BgSurfaceColor}" />
    <SolidColorBrush x:Key="BgPanel" Color="{StaticResource BgPanelColor}" />
    <SolidColorBrush x:Key="BgPanelMuted" Color="{StaticResource BgPanelMutedColor}" />
    <SolidColorBrush x:Key="BorderSubtle" Color="{StaticResource BorderSubtleColor}" />

    <SolidColorBrush x:Key="NeonPrimary" Color="{StaticResource NeonPrimaryColor}" />
    <SolidColorBrush x:Key="NeonGlow" Color="{StaticResource NeonGlowColor}" />
    <SolidColorBrush x:Key="NeonHighlight" Color="{StaticResource NeonHighlightColor}" />
    <SolidColorBrush x:Key="AccentBlue" Color="{StaticResource AccentBlueColor}" />
    <SolidColorBrush x:Key="AccentCyan" Color="{StaticResource AccentCyanColor}" />
    <SolidColorBrush x:Key="AccentGreen" Color="{StaticResource AccentGreenColor}" />
    <SolidColorBrush x:Key="AccentAmber" Color="{StaticResource AccentAmberColor}" />

    <SolidColorBrush x:Key="TextStrong" Color="{StaticResource TextStrongColor}" />
    <SolidColorBrush x:Key="TextBody" Color="{StaticResource TextBodyColor}" />
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="ColorError" Color="{StaticResource ColorErrorColor}" />
    <SolidColorBrush x:Key="ColorSuccess" Color="{StaticResource ColorSuccessColor}" />
    
    <!-- Semi-transparent overlay backdrop -->
    <SolidColorBrush x:Key="TranslucentBg" Color="#B00A0A0F" />

</ResourceDictionary>
